# FRED API-Key: kostenlos unter https://fred.stlouisfed.org/docs/api/api_key.html
# Ohne Key nutzt das Backend automatisch den keylosen CSV-Export von FRED (fredgraph.csv).
FRED_API_KEY=

# Erlaubte Frontend-Origins (kommagetrennt)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Wie lange eine FRED-Serie im Speicher gecacht wird (Sekunden). WALCL ist woechentlich -> 1h reicht.
CACHE_TTL_SECONDS=3600

# Anthropic-API-Key fuer die KI-Erklaerungen: https://console.anthropic.com/settings/keys
# Ohne Key zeigt das Dashboard einen Hinweis statt des Textes.
ANTHROPIC_API_KEY=
# Modell und Denk-Aufwand fuer die Erklaerungen (low | medium | high)
EXPLAIN_MODEL=claude-opus-5
EXPLAIN_EFFORT=medium

# Erklaerungen pro Saeule. auto = Claude wenn Key, sonst Gemini wenn Key, sonst Ollama wenn er laeuft,
# sonst regelbasiert (immer kostenlos). Erzwingen mit: template | ollama | gemini | anthropic | none
EXPLAIN_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Phase D: Persistenz, Refresh, Hinweise ---------------------------------------------------------
# SQLite-Verzeichnis (Standard backend/data). Rohdaten von der Platte gelten 20 h als frisch, bei Netzausfall
# dienen sie unabhaengig vom Alter als Rueckfall.
# DATA_DIR=
DISK_CACHE_TTL_SECONDS=72000
# Taeglicher Refresh im Hintergrund der API (lokale Uhrzeit); false = nur per POST /api/v1/refresh
AUTO_REFRESH=true
REFRESH_HOUR=7
REFRESH_MINUTE=30
# Token fuer POST /api/v1/refresh (Header X-Refresh-Token). Leer = kein Token noetig (nur lokal sinnvoll).
REFRESH_TOKEN=

# Hinweis bei Regimewechsel: ntfy.sh ist kostenlos und braucht kein Konto. App installieren, Thema abonnieren,
# hier eintragen (lang und zufaellig waehlen, das Thema ist das Passwort).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional E-Mail per SMTP (z. B. Gmail mit App-Passwort: smtp.gmail.com, Port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
